<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hansc.aistock.watch</string>
	<!-- 평일 07:30 시작 → 19:00 자동 종료. 장중 신호는 바로 제안, 장외 신호는 다음 장에서 재평가 -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/hansc/projects/aistock/.venv/bin/aistock</string>
		<string>dart</string>
		<string>watch</string>
		<string>--signals</string>
		<string>--propose</string>
		<string>--weekdays</string>
		<string>--until</string>
		<string>19:00</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/hansc/projects/aistock</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key><integer>1</integer>
			<key>Hour</key><integer>7</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>2</integer>
			<key>Hour</key><integer>7</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>3</integer>
			<key>Hour</key><integer>7</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>4</integer>
			<key>Hour</key><integer>7</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>5</integer>
			<key>Hour</key><integer>7</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
	</array>
	<!-- 장중에 죽으면 다시 띄운다. 19:00 정상 종료(exit 0)는 다시 띄우지 않는다 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/Users/hansc/projects/aistock/logs/watch.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/hansc/projects/aistock/logs/watch.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
