# 키움 REST API base URL
KIWOOM_PRD_URL=https://api.kiwoom.com
KIWOOM_MOCK_URL=https://mockapi.kiwoom.com
KIWOOM_WS_PRD_URL=wss://api.kiwoom.com:10000
KIWOOM_WS_MOCK_URL=wss://mockapi.kiwoom.com:10000

# real = 실전투자, demo = 모의투자
KIWOOM_MODE=demo

# 실전투자 키
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 모의투자 키 (키움에서 별도 발급)
KIWOOM_APP_KEY_MOCK=
KIWOOM_APP_SECRET_MOCK=

# 계좌번호
KIWOOM_ACCOUNT_NO=

# DART 전자공시 OpenAPI 인증키 (https://opendart.fss.or.kr 에서 발급, 40자리)
DART_API_KEY=

# Claude API 인증키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 텔레그램 알림 (@BotFather 로 봇 생성 후 발급)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 주문 1건 금액 상한(원). 실수로 수량에 0을 더 붙이는 사고를 막는다.
MAX_ORDER_AMOUNT=10000000

# Ollama (사내망 모델). SIGNAL_BACKEND=ollama 로 분석기 교체
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:120b
SIGNAL_BACKEND=claude

# 봇 명령을 허용할 추가 chat_id (쉼표 구분). 기본은 TELEGRAM_CHAT_ID 하나뿐
TELEGRAM_ALLOWED_CHAT_IDS=

# 반자동 매매 (dart watch --signals --propose). 승인 버튼을 눌러야만 주문이 나간다.
TRADE_BUDGET=1000000           # 매수 제안 1건 예산(원)
TRADE_MIN_CONFIDENCE=70        # 이 미만 신호는 제안하지 않음
TRADE_MAX_DAILY_BUYS=3         # 하루 매수 제안 상한
TRADE_PROPOSAL_TTL_MIN=10      # 승인 유효시간(분)
TRADE_MAX_DRIFT_PCT=2.0        # 제안가 대비 불리하게 이만큼 움직이면 승인해도 주문 안 함
TRADE_STOP_LOSS_PCT=5          # 보유 수익률 -5% 이하면 손절 제안 (0=끔)
TRADE_TAKE_PROFIT_PCT=10       # 보유 수익률 +10% 이상이면 익절 제안 (0=끔)
TRADE_EXIT_CHECK_MIN=5         # 손절·익절 점검 주기(분)
TRADE_MAX_GAP_PCT=5            # 장외 신호: 다음 장 갭상승이 이보다 크면 매수 제안 안 함
TRADE_DEFERRED_MAX_DAYS=3      # 장외 신호 보관 기한(일)
TRADE_RELEASE_AFTER=09:05      # 장외 신호 재평가 시각

# 미국주식 (TQQQ). 주문은 모두 텔레그램 [승인] 버튼을 거친다. 지정가만.
MAX_ORDER_AMOUNT_USD=0         # 미국 주문 1건 상한(USD). 0=상한 없음 (미설정 시 7000)
TRADE_US_SYMBOLS=TQQQ          # 차트 신호를 볼 종목 (쉼표 구분)
TRADE_US_BUDGET_USD=0          # 매수 제안 1건 예산(USD). 0=외화 주문가능금액 전부
TRADE_US_STOP_LOSS_PCT=10      # 0=끔
TRADE_US_TAKE_PROFIT_PCT=20    # 0=끔
TRADE_US_CHECK_AFTER=10:00     # 뉴욕 시각. 이전엔 신호를 보지 않음
TRADE_US_TREND_SMA=200
TRADE_US_SMA_BUFFER_PCT=3      # 200일선 ±3% 안의 출렁임은 돌파·이탈로 보지 않음
TRADE_US_PULLBACK_RSI=40       # 상승 추세 중 RSI가 이 이하면 '눌림' 매수

# 경제 봇 (텔레그램에 / 없이 말 걸기). Claude Opus 5.5 + 웹 검색 — 질문당 API 비용 발생
ADVISOR_DAILY_LIMIT=40         # 하루 질문 상한 (0=무제한)
TRADE_US_CHECK_SEC=60          # 미국 종목 점검 주기(초)
TRADE_US_REALERT_MIN=15        # 못 보고 만료된 매수 제안 재알림 간격(분)
TRADE_US_RESTING=1             # 매일 신호 가격에 지정가 걸어두기 제안 (0=끔)
TRADE_US_EXTENDED_HOURS=1     # 승인한 미국 주문을 장외(프리·애프터마켓)에도 키움으로 보냄 (0=정규장만)

# 메리츠증권 Open API (조회 전용) — https://openapi.imeritz.com 에서 계좌별로 신청
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
TRADE_BRIEF_KR_AT=08:40        # 국내 관심·보유 브리핑 (한국 시각, 평일). 비우면 끔
TRADE_BRIEF_US_AT=09:00        # 미국 관심·보유 브리핑 (뉴욕 시각). 비우면 끔
TRADE_REVIEW=1                 # 제안마다 3개월 차트 + 경제 봇 의견(찬성·주의·반대)을 답장으로. 0이면 끔
TRADE_US_EVENT_HOLD=1          # FOMC·CPI·고용보고서 발표 전 거래일 ~ 발표 30분 뒤 미국 매수 제안 보류 (0=끔)
TRADE_US_UNDERLYING=           # 레버리지→기초지수 "TQQQ:QQQ,SOXL:SOXX". 비우면 기본 목록, 0이면 끔
TRADE_ADD_ON_PULLBACK=1        # 보유 종목 상승 추세 중 눌림이면 추가 매수 제안 (0=끔)
TRADE_EXIT_CHECK_MIN=1         # 국내 보유 종목 점검 주기(분)
